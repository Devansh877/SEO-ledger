# Copy to backend/.env and fill in real values. NEVER commit backend/.env,
# and never put a real credential in THIS file — it is tracked by git.

# --- Core ---
# Postgres connection strings from Neon (or any Postgres instance).
# DATABASE_URL: pooled connection, used by the running app.
# DIRECT_URL: direct (unpooled) connection, used by `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Any long random string, e.g. `openssl rand -base64 48`.
JWT_SECRET="generate-a-long-random-string"
PORT=4000
# Public URL of the deployed frontend, including scheme, no trailing slash.
FRONTEND_URL="https://your-frontend.vercel.app"
# Shared secret Vercel Cron sends as a Bearer token to /cron/poll-all.
CRON_SECRET="generate-a-long-random-string"

# Public URL of THIS backend. Used to build the OAuth redirect URI, which
# must exactly match the one registered in Google Cloud.
BACKEND_URL="https://your-backend.vercel.app"
# Encrypts stored OAuth tokens at rest. 32 bytes, base64:
#   openssl rand -base64 32
# Changing this invalidates every stored connection — each would need
# reconnecting through the consent screen.
ENCRYPTION_KEY=""

# --- Google OAuth (how clients connect their properties) ---
# One OAuth client covers GA4, Search Console and Business Profile.
# Google Cloud -> Credentials -> OAuth client ID -> Web application.
# Authorised redirect URI must be exactly: <BACKEND_URL>/oauth/google/callback
#
# Publish the consent screen to "In production". While it is in "Testing"
# with an External user type, Google expires refresh tokens after 7 days,
# which silently breaks the weekly capture for every connected client.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Rank tracking provider ---
# Which SERP source powers the "dataforseo" rank column. "serper" is the
# default: 2,500 free credits covers roughly 10 clients x 20 keywords weekly
# at no cost. "dataforseo" if you already have an account. "none" leaves
# rank capture to Search Console alone.
RANK_PROVIDER="serper"
SERPER_API_KEY=""

# --- GA4 Data API (legacy service-account path) ---
# Still supported as a fallback for properties connected before OAuth, but
# OAuth above is the path for new clients — it covers all three products in
# one sign-in and is the only way to reach Business Profile.
# Service account JSON, base64-encoded, with Viewer access on each client's
# GA4 property. Generate with:
#   base64 -w0 service-account.json
# https://developers.google.com/analytics/devguides/reporting/data/v1
GA4_SERVICE_ACCOUNT_KEY_BASE64=""

# --- Google Search Console API ---
# Only set this if you use a SEPARATE service account from GA4 above;
# otherwise leave blank and googleAuth.js falls back to the GA4 key.
GSC_SERVICE_ACCOUNT_KEY_BASE64=""

# --- DataForSEO (keyword rankings + search volume) ---
# https://dataforseo.com/apis
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# --- Google Business Profile API ---
# OAuth client for GMB Performance + Business Information APIs
# https://developers.google.com/my-business
GMB_OAUTH_CLIENT_ID=""
GMB_OAUTH_CLIENT_SECRET=""
