# Copy to backend/.env and fill in real values. NEVER commit backend/.env,
# and never put a real credential in THIS file — it is tracked by git.

# --- Core ---
# Postgres connection strings from Neon (or any Postgres instance).
# DATABASE_URL: pooled connection, used by the running app.
# DIRECT_URL: direct (unpooled) connection, used by `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Any long random string, e.g. `openssl rand -base64 48`.
JWT_SECRET="generate-a-long-random-string"
PORT=4000
# Public URL of the deployed frontend, including scheme, no trailing slash.
FRONTEND_URL="https://your-frontend.vercel.app"
# Shared secret Vercel Cron sends as a Bearer token to /cron/poll-all.
CRON_SECRET="generate-a-long-random-string"

# --- GA4 Data API ---
# Service account JSON, base64-encoded, with Viewer access on each client's
# GA4 property. Generate with:
#   base64 -w0 service-account.json
# https://developers.google.com/analytics/devguides/reporting/data/v1
GA4_SERVICE_ACCOUNT_KEY_BASE64=""

# --- Google Search Console API ---
# Only set this if you use a SEPARATE service account from GA4 above;
# otherwise leave blank and googleAuth.js falls back to the GA4 key.
GSC_SERVICE_ACCOUNT_KEY_BASE64=""

# --- DataForSEO (keyword rankings + search volume) ---
# https://dataforseo.com/apis
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# --- Google Business Profile API ---
# OAuth client for GMB Performance + Business Information APIs
# https://developers.google.com/my-business
GMB_OAUTH_CLIENT_ID=""
GMB_OAUTH_CLIENT_SECRET=""
