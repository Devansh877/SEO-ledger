# --- Core ---

# Postgres connectiENCRYPTION_KEY="PUxRgB/Dfev+0SrqQ4BdAAG45Xg4ZoOTqhPJtx6x8tA="on strings from Neon (or any Postgres instance).
# DATABASE_URL: pooled connection, used by the running app.
# DIRECT_URL: direct (unpooled) connection, used by `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
# Public URL of the deployed frontend (Vercel project or Hostinger app).
FRONTEND_URL="https://your-frontend.vercel.app"
# Shared secret Vercel Cron sends as a Bearer token to /cron/poll-all.
# Set the same value as an env var on the Vercel Cron configuration.
CRON_SECRET="replace-with-another-long-random-string"

# --- GA4 Data API ---
# Service account JSON (base64) with Viewer access on each client's GA4 property.
# https://developers.google.com/analytics/devguides/reporting/data/v1
GA4_SERVICE_ACCOUNT_KEY_BASE64=""

# --- Google Search Console API ---
# Reuses the same service account as GA4 (Viewer/read access on each
# client's verified Search Console property).
GSC_SERVICE_ACCOUNT_KEY_BASE64=""

# --- DataForSEO (keyword rankings + search volume) ---
# https://dataforseo.com/apis
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# --- Google Business Profile API ---
# OAuth client for GMB Performance + Business Information APIs
# https://developers.google.com/my-business
GMB_OAUTH_CLIENT_ID=""
GMB_OAUTH_CLIENT_SECRET=""
