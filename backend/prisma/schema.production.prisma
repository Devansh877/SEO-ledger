// Production schema for Hostinger Business/Cloud hosting, which provides a
// hosted MySQL database rather than persistent local disk (the Node.js Web
// App filesystem is ephemeral, so SQLite's file-based dev.db would be wiped
// on every redeploy).
//
// Usage on Hostinger, from the backend app's build command:
//   npx prisma generate --schema=prisma/schema.production.prisma
//   npx prisma migrate deploy --schema=prisma/schema.production.prisma
//
// DATABASE_URL for MySQL looks like:
//   mysql://USER:PASSWORD@HOST:3306/DBNAME
// Create the database and user first under hPanel -> Databases -> MySQL
// Databases, then paste its connection details into this app's env vars.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  client       Client?  @relation(fields: [clientId], references: [id])
  clientId     String?
  createdAt    DateTime @default(now())
}

model Client {
  id            String        @id @default(cuid())
  name          String
  industry      String
  ga4PropertyId String?
  gmbLocationId String?
  users         User[]
  access        AccessGrant[]
  createdAt     DateTime      @default(now())
}

model AccessGrant {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id])
  clientId  String
  module    String
  granted   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([clientId, module])
}
